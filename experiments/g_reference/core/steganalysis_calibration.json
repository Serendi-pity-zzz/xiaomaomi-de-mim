{
  "schema": "steganalysis-calibration/1",
  "method": "chi_square_bias_adjusted",
  "created": "2026-11-15",
  "threshold": 0.5,
  "threshold_rule": "结构化覆盖样本最大分数加 0.05 裕量为下界，可检测含密样本最小分数为上界；区间 [0.05, 0.59] 内取可解释的 0.5，兼顾裕量与检出率。",
  "threshold_interval": {
    "lower": 0.050046,
    "upper": 0.593774
  },
  "score_definition": "score = P(χ²_k-1 >= r_adj)，其中 r 为经典值对卡方统计量，r_adj = max(0, r - 2N(b-0.5)^2)，b 为区域内 LSB 为 1 的比例。score 是检测分数，不是含密概率或严格 p 值。",
  "calibration_set": {
